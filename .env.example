# Fika reads these from the process environment (it has no dotenv). Locally: `set NAME=value` (Windows cmd) or `export NAME=value`, then `node server.js`.
# On Render set them in the dashboard (or render.yaml). Never commit a real .env file.

# --- server
PORT=3000                      # Render sets this itself
#HOST=0.0.0.0                  # only if you need to override; Render is detected automatically
DB_FILE=./data/db.json         # on Render: /var/data/db.json (persistent disk)
#SEED_FILE=./seed.json

# --- security
#COOKIE_SECURE=1               # set when the site is served over https. Turns on strict staff rules
#ADMIN_STRICT=1                # strict staff rules without https (12+ char passwords, mandatory 2FA)
#ADMIN_MFA=off                 # on|off override for 2FA (local testing only)
#TRUST_PROXY=1                 # how many reverse proxies sit in front (Render: 1 or 2, see docs/deploy-render.md)
#PUBLIC_URL=https://example.com
DATA_KEY=                      # long random string; encrypts 2FA secrets + backups (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#HIBP=0                        # 0 = don't check passwords against the Have I Been Pwned range API

# --- first owner (optional; otherwise use the setup form at /admin.html)
#OWNER_EMAIL=
#OWNER_PASSWORD=               # remove again after the first successful login
#RESET_OWNER_MFA=1             # one-off: clears the owner's 2FA (lost phone), then remove

# --- tuning
#GAME_MIN_MS=15000
#BACKUP_KEEP=14
#RETENTION_ANALYTICS_DAYS=90
#RETENTION_AUDIT_DAYS=365
#RETENTION_ORDER_DAYS=395
